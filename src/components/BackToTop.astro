---
interface Props { threshold?: number; label?: string; }
const { threshold = 720, label = 'Voltar ao início da página' } = Astro.props;
---

<button class="back-to-top" type="button" aria-label={label} data-back-to-top data-threshold={threshold}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6" /></svg>
</button>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-back-to-top]');

  for (const button of buttons) {
    const threshold = Number(button.dataset.threshold ?? 720);
    const updateVisibility = () => button.classList.toggle('is-visible', window.scrollY > threshold);
    updateVisibility();
    window.addEventListener('scroll', updateVisibility, { passive: true });
    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  .back-to-top { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 20; display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid currentColor; border-radius: 999px; color: inherit; background: Canvas; opacity: 0; pointer-events: none; transform: translateY(.5rem); transition: opacity 180ms ease, transform 180ms ease; }
  .back-to-top.is-visible { opacity: 1; pointer-events: auto; transform: none; }
  .back-to-top svg { width: 1.25rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
  @media (prefers-reduced-motion: reduce) { .back-to-top { transition: none; } }
</style>
