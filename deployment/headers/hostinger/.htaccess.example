# Copie este arquivo para a raiz do dist publicado na Hostinger como .htaccess.
# O servidor precisa permitir mod_headers; confirme os headers na URL publicada.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"

  # Ative somente após confirmar HTTPS no domínio real:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
